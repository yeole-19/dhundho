<% content_for :title, "Edit Person - Dhundho Lost & Found" %>

<div style="max-width: 600px; margin: 0 auto;">
  <div class="page-header">
    <h1 class="page-title">Edit Person</h1>
    <p class="page-subtitle">Update details for "<%= @person.name %>"</p>
  </div>

  <div class="card">
    <%= form_with model: @person, local: true do |form| %>
      <% if @person.errors.any? %>
        <div class="flash flash-error">
          <strong>Please fix the following errors:</strong>
          <ul style="margin: 12px 0 0 20px;">
            <% @person.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-input" %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= form.label :role, class: "form-label" %>
          <%= form.select :role, [["Student", "Student"], ["Faculty", "Faculty"], ["Staff", "Staff"], ["Visitor", "Visitor"], ["Other", "Other"]], {}, class: "form-select" %>
        </div>
        <div class="form-group">
          <%= form.label :gender, class: "form-label" %>
          <%= form.select :gender, [["Male", "Male"], ["Female", "Female"], ["Non-binary", "Non-binary"], ["Prefer not to say", "Prefer not to say"]], {}, class: "form-select" %>
        </div>
      </div>

      <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px; padding-top: 24px; border-top: 1px solid #f0f0f0;">
        <%= link_to "Cancel", @person, class: "btn btn-secondary" %>
        <%= form.submit "Save Changes", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>