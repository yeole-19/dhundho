<div id="<%= dom_id item %>">
  <div>
    <strong>Title:</strong>
    <%= item.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= item.description %>
  </div>

  <div>
    <strong>Category:</strong>
    <%= item.category %>
  </div>

  <div>
    <strong>Status:</strong>
    <%= item.status %>
  </div>

  <div>
    <strong>Found at:</strong>
    <%= item.found_at %>
  </div>

  <div>
    <strong>Contact:</strong>
    <%= item.contact %>
  </div>

  <div>
    <strong>Resolved:</strong>
    <%= item.resolved %>
  </div>

</div>
