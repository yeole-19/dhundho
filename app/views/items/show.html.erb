<% content_for :title, "#{@item.title} - Dhundho Lost & Found" %>

<div class="item-detail">
  <div class="detail-main">
    <div class="page-header">
      <div style="display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
          <h1 class="page-title"><%= @item.title %></h1>
          <p class="page-subtitle">Item details and community comments</p>
        </div>
        <div style="display: flex; gap: 12px;">
          <%= link_to "Edit", edit_item_path(@item), class: "btn btn-secondary" %>
          <%= button_to "Delete", @item, method: :delete, data: { confirm: "Are you sure you want to delete this item?" }, class: "btn btn-danger" %>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="detail-section">
        <div class="detail-label">Description</div>
        <div class="detail-value" style="font-size: 16px; line-height: 1.7; color: #4b5563;"><%= @item.description %></div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 24px;">
        <div class="detail-section">
          <div class="detail-label">Category</div>
          <div class="detail-value"><span class="meta-badge badge-category"><%= @item.category %></span></div>
        </div>
        <div class="detail-section">
          <div class="detail-label">Status</div>
          <div class="detail-value"><span class="meta-badge badge-status-<%= @item.status.downcase %>"><%= @item.status %></span></div>
        </div>
        <div class="detail-section">
          <div class="detail-label">Contact</div>
          <div class="detail-value"><%= @item.contact %></div>
        </div>
        <div class="detail-section">
          <div class="detail-label">Found At</div>
          <div class="detail-value"><%= @item.found_at %></div>
        </div>
        <div class="detail-section">
          <div class="detail-label">Reported By</div>
          <div class="detail-value"><%= @item.person&.name || "Not specified" %></div>
        </div>
        <div class="detail-section">
          <div class="detail-label">Status</div>
          <div class="detail-value"><span class="meta-badge badge-resolved-<%= @item.resolved %>"><%= @item.resolved ? "Resolved" : "Active" %></span></div>
        </div>
      </div>

      <% unless @item.resolved? %>
        <div style="margin-top: 24px; padding-top: 24px; border-top: 1px solid #f0f0f0;">
          <%= button_to "Mark as Resolved", resolve_item_path(@item), method: :patch, class: "btn btn-primary", style: "width: 100%;" %>
        </div>
      <% end %>
    </div>

    <section class="comments-section">
      <h2 class="comments-title">Comments (<%= @item.comments.count %>)</h2>
      
      <div id="comments">
        <% if @item.comments.any? %>
          <% @item.comments.each do |comment| %>
            <article class="comment">
              <div class="comment-header">
                <div class="comment-avatar"><%= comment.person.name[0].upcase %></div>
                <strong class="comment-author"><%= comment.person.name %></strong>
                <span style="color: #9ca3af; font-size: 13px;"><%= time_ago_in_words(comment.created_at) %> ago</span>
              </div>
              <p class="comment-content"><%= comment.content %></p>
            </article>
          <% end %>
        <% else %>
          <div class="empty-state" style="padding: 40px 20px;">
            <div class="empty-icon">💬</div>
            <h3 class="empty-title">No comments yet</h3>
            <p class="empty-desc">Be the first to share your thoughts on this item!</p>
          </div>
        <% end %>
      </div>

      <div class="comment-form">
        <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; color: #1a1a2e;">Add a Comment</h3>
        <%= form_with model: [ @item, @item.comments.build ], local: true do |form| %>
          <div class="form-group">
            <%= form.text_area :content, class: "form-textarea", placeholder: "Share your thoughts, questions, or additional info...", rows: 4 %>
          </div>
          <div class="form-group" style="margin-top: 12px;">
            <%= form.label :person_id, "Your Name", style: "display: block; margin-bottom: 6px; font-weight: 500; color: #374151;" %>
            <%= form.select :person_id, Person.all.map { |p| [p.name, p.id] }, { include_blank: "Select your name" }, { class: "form-select", style: "width: 100%; padding: 10px 12px; border: 1px solid #e5e7eb; border-radius: 8px; font-size: 14px; background: white;" } %>
          </div>
          <div style="display: flex; justify-content: flex-end; margin-top: 16px;">
            <%= form.submit "Post Comment", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </section>
  </div>

  <aside class="detail-sidebar">
    <div class="card" style="position: sticky; top: 100px;">
      <h3 style="font-size: 18px; font-weight: 600; margin-bottom: 20px; color: #1a1a2e;">Quick Actions</h3>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <%= link_to "← Back to Items", items_path, class: "btn btn-secondary" %>
<% unless @item.resolved? %>
          <%= button_to "✓ Mark Resolved", resolve_item_path(@item), method: :patch, class: "btn btn-primary" %>
        <% else %>
          <span class="btn btn-secondary" style="background: #e8f5e9; color: #2e7d32;">✓ Resolved</span>
        <% end %>
      </div>
    </div>
  </aside>
</div>