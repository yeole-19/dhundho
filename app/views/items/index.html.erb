<% content_for :title, "Items - Dhundho Lost & Found" %>

<div class="page-header">
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div>
      <h1 class="page-title">All Items</h1>
      <p class="page-subtitle">Browse lost and found items in your community</p>
    </div>
    <%= link_to "Report New Item", new_item_path, class: "btn btn-primary" %>
  </div>
</div>

<% if @items.any? %>
  <div class="grid">
    <% @items.each do |item| %>
      <article class="card">
        <div class="card-header">
          <h2 class="card-title"><%= link_to item.title, item, style: "color: inherit; text-decoration: none;" %></h2>
        </div>
        
        <p class="card-description"><%= truncate(item.description, length: 120) %></p>
        
        <div class="card-meta">
          <span class="meta-badge badge-category">📂 <%= item.category %></span>
          <span class="meta-badge badge-status-<%= item.status.downcase %>"><%= item.status %></span>
          <span class="meta-badge badge-resolved-<%= item.resolved %>"><%= item.resolved ? "Resolved" : "Active" %></span>
        </div>

        <% if item.person.present? %>
          <div style="margin-top: 12px; font-size: 13px; color: #6b7280;">
            👤 Reported by: <%= link_to item.person.name, person_path(item.person) %>
          </div>
        <% end %>

        <div class="card-footer">
          <%= link_to "View Details", item, class: "btn btn-primary btn-sm" %>
          <%= link_to "Edit", edit_item_path(item), class: "btn btn-secondary btn-sm" %>
        </div>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="card empty-state">
    <div class="empty-icon">📦</div>
    <h3 class="empty-title">No items yet</h3>
    <p class="empty-desc">Be the first to report a lost or found item in your community!</p>
    <%= link_to "Report New Item", new_item_path, class: "btn btn-primary", style: "margin-top: 16px; display: inline-flex;" %>
  </div>
<% end %>