<!DOCTYPE html>
<html>
<head>
  <title><%= content_for?(:title) ? yield(:title) : "Dhundho Lost & Found" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    
    body { 
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; 
      background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
      min-height: 100vh;
      color: #1a1a2e;
    }

    /* Header / Navbar */
    .header {
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      padding: 0;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    }

    .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 72px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: white;
    }

    .logo-icon {
      width: 44px;
      height: 44px;
      background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
    }

    .logo-text {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .logo-title {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.5px;
      color: #fff;
    }

    .logo-subtitle {
      font-size: 11px;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.6);
      text-transform: uppercase;
      letter-spacing: 1.5px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-link {
      padding: 10px 20px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      font-size: 14px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-link-primary {
      background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
      color: #1a1a2e;
    }

    .nav-link-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 212, 170, 0.4);
    }

    .nav-link-secondary {
      background: rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .nav-link-secondary:hover {
      background: rgba(255, 255, 255, 0.2);
      color: #fff;
    }

    .nav-link-danger {
      background: rgba(220, 53, 69, 0.2);
      color: #ff6b6b;
      border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .nav-link-danger:hover {
      background: rgba(220, 53, 69, 0.3);
    }

    /* Main Content */
    .main-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }

    .page-header {
      margin-bottom: 32px;
    }

    .page-title {
      font-size: 36px;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 8px;
      letter-spacing: -1px;
    }

    .page-subtitle {
      color: #6b7280;
      font-size: 16px;
    }

    /* Flash Messages */
    .flash-messages {
      margin-bottom: 24px;
    }

    .flash {
      padding: 16px 20px;
      border-radius: 10px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .flash-notice { background: #e8f5e9; color: #2e7d32; border-left: 4px solid #4caf50; }
    .flash-alert { background: #fef3e2; color: #e65100; border-left: 4px solid #ff9800; }
    .flash-error { background: #fdeaea; color: #c62828; border-left: 4px solid #ef5350; }

    /* Cards */
    .card {
      background: white;
      border-radius: 16px;
      padding: 28px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
      border: 1px solid rgba(0, 0, 0, 0.04);
      transition: all 0.3s ease;
    }

    .card:hover {
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      transform: translateY(-2px);
    }

    .card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 16px;
    }

    .card-title {
      font-size: 22px;
      font-weight: 600;
      color: #1a1a2e;
    }

    .card-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 16px;
    }

    .meta-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 500;
    }

    .badge-category { background: #e3f2fd; color: #1565c0; }
    .badge-status-lost { background: #fce4ec; color: #c2185b; }
    .badge-status-found { background: #e8f5e9; color: #2e7d32; }
    .badge-resolved-true { background: #e8f5e9; color: #2e7d32; }
    .badge-resolved-false { background: #fff3e0; color: #e65100; }

    .card-description {
      color: #4b5563;
      line-height: 1.7;
      margin: 16px 0;
    }

    .card-footer {
      display: flex;
      gap: 12px;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #f0f0f0;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
      color: #1a1a2e;
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 212, 170, 0.4);
    }

    .btn-secondary {
      background: #f3f4f6;
      color: #374151;
      border: 1px solid #e5e7eb;
    }

    .btn-secondary:hover {
      background: #e5e7eb;
    }

    .btn-danger {
      background: #fee2e2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    .btn-danger:hover {
      background: #fecaca;
    }

    .btn-sm { padding: 8px 16px; font-size: 13px; }

    /* Grid Layouts */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: 24px;
    }

    .grid-2 {
      grid-template-columns: repeat(auto-fill, minmax(500px, 1fr));
    }

    /* Forms */
    .form-group { margin-bottom: 20px; }
    .form-label {
      display: block;
      margin-bottom: 8px;
      font-weight: 500;
      color: #374151;
    }
    .form-input, .form-textarea, .form-select {
      width: 100%;
      padding: 12px 16px;
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      font-size: 15px;
      font-family: inherit;
      transition: all 0.2s ease;
      background: white;
    }
    .form-input:focus, .form-textarea:focus, .form-select:focus {
      outline: none;
      border-color: #00d4aa;
      box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.15);
    }
    .form-textarea { min-height: 120px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    /* Comments */
    .comments-section {
      margin-top: 32px;
      padding-top: 32px;
      border-top: 1px solid #f0f0f0;
    }

    .comments-title {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 20px;
      color: #1a1a2e;
    }

    .comment {
      background: #fafafa;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
      border: 1px solid #f0f0f0;
      transition: all 0.2s ease;
    }

    .comment:hover {
      background: #f5f5f5;
      border-color: #e0e0e0;
    }

    .comment-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 10px;
    }

    .comment-avatar {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #1a1a2e;
      font-weight: 700;
      font-size: 14px;
    }

    .comment-author { font-weight: 600; color: #1a1a2e; }
    .comment-content { color: #4b5563; line-height: 1.6; }

    .comment-form {
      background: #fafafa;
      border-radius: 12px;
      padding: 24px;
      border: 1px solid #f0f0f0;
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #9ca3af;
    }

    .empty-icon {
      font-size: 56px;
      margin-bottom: 16px;
      opacity: 0.5;
    }

    .empty-title { font-size: 20px; font-weight: 600; color: #6b7280; margin-bottom: 8px; }
    .empty-desc { font-size: 15px; }

    /* Item Detail Specific */
    .item-detail {
      display: grid;
      grid-template-columns: 1fr 380px;
      gap: 32px;
    }

    @media (max-width: 900px) {
      .item-detail { grid-template-columns: 1fr; }
    }

    .detail-main { min-width: 0; }
    .detail-sidebar { min-width: 0; }

    .detail-section {
      margin-bottom: 24px;
    }

    .detail-label {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #9ca3af;
      margin-bottom: 6px;
    }

    .detail-value { font-size: 16px; color: #1a1a2e; }

    /* Footer */
    .footer {
      text-align: center;
      padding: 40px 24px;
      color: #9ca3af;
      font-size: 14px;
      border-top: 1px solid #e5e7eb;
      margin-top: 40px;
    }

    /* Mobile Menu */
    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      color: white;
      font-size: 24px;
      cursor: pointer;
    }

    @media (max-width: 640px) {
      .nav-links { display: none; position: absolute; top: 72px; left: 0; right: 0; background: #1a1a2e; flex-direction: column; padding: 20px; gap: 12px; border-top: 1px solid rgba(255,255,255,0.1); }
      .nav-links.open { display: flex; }
      .mobile-menu-btn { display: block; }
      .page-title { font-size: 28px; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header class="header">
    <nav class="nav-container" role="navigation" aria-label="Main navigation">
      <a href="/" class="logo" aria-label="Dhundho Lost & Found Home">
        <div class="logo-icon">🔍</div>
        <div class="logo-text">
          <span class="logo-title">Dhundho Lost & Found</span>
          <span class="logo-subtitle">Community Platform</span>
        </div>
      </a>

      <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false" onclick="toggleMenu()">
        ☰
      </button>

      <div class="nav-links" id="navLinks">
        <%= link_to "Items", items_path, class: "nav-link nav-link-secondary" %>
        <%= link_to "People", people_path, class: "nav-link nav-link-secondary" %>
        <%= link_to "New Item", new_item_path, class: "nav-link nav-link-primary" %>
      </div>
    </nav>
  </header>

  <main class="main-content" role="main">
    <div class="flash-messages">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>">
          <span><%= message %></span>
        </div>
      <% end %>
    </div>

    <%= yield %>
  </main>

  <footer class="footer">
    <p>Dhundho Lost & Found &copy; 2026 - Connecting community through lost & found items</p>
  </footer>

  <script>
    function toggleMenu() {
      const nav = document.getElementById('navLinks');
      const btn = document.querySelector('.mobile-menu-btn');
      nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', nav.classList.contains('open'));
    }
  </script>
</body>
</html>